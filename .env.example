# Database (use a pooled URL on Vercel, e.g. Neon "Pooled connection")
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Auth (production: your Vercel URL, e.g. https://your-app.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-string

# Comma-separated frontend URLs allowed for CORS and auth
TRUSTED_ORIGINS=http://localhost:5173

# OpenRouter / AI
AI_API_KEY=
AI_MODEL=kwaipilot/kat-coder-pro-v2
AI_MAX_TOKENS=8192

# Client build (set in Vercel to your deployment URL before build)
VITE_BASEURL=http://localhost:3000
